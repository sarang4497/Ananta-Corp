# Ananta Corporation — environment template
# Copy to `.env.local` for local dev; set the same names in Vercel (Production).
# NEVER commit real secrets.

# --- Enquiry email notifications (Resend, https://resend.com) ----------------
# Server-only. Without it, enquiries are still accepted and recorded in the
# server log ([lead:received]) but no email is sent ([lead:email-not-configured]).
RESEND_API_KEY=
# Recipient(s), comma-separated. Defaults to info@anantacorporation.com.
LEAD_NOTIFY_TO=info@anantacorporation.com
# Sender. Must be on a domain verified in Resend (e.g. leads@anantacorporation.com).
# Until a domain is verified, Resend's test sender (onboarding@resend.dev) only
# delivers to the email address that owns the Resend account.
LEAD_EMAIL_FROM=Ananta Website <onboarding@resend.dev>
