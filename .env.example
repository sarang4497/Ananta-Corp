# ============================================================================
# Ananta Corporation — environment template
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser (safe-to-publish only).
# Everything else is server-only and must never reach the client bundle.
# ============================================================================

# --- AI chat assistant (Anthropic) --------------------------------------------
# Server-side only. Used by /api/chat. Never expose to the client.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to "claude-opus-4-8" in code.
# Switch to "claude-sonnet-4-6" to cut cost.
CHAT_MODEL=

# --- Cloudflare Turnstile (invisible bot protection) --------------------------
# Site key is public by design; secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email verification (Resend) ----------------------------------------------
# Server-side only. Sends the 6-digit verification code + new-lead notice.
RESEND_API_KEY=
# Must be a verified sender on your Resend account.
RESEND_FROM="Ananta Corporation <onboarding@resend.dev>"
# Where new-lead notifications are sent (your inbox). Optional.
LEAD_NOTIFY_TO=

# --- Session signing ----------------------------------------------------------
# Server-side only. Long random string used to HMAC-sign session/visitor cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Voice input --------------------------------------------------------------
# Active transcription provider. One of: browser | api | wispr
#   browser -> Web Speech API in the browser (free, default, no key needed)
#   api     -> records audio and POSTs to /api/transcribe (paid STT, see below)
#   wispr   -> stub for future Wispr Flow access (NOT active yet)
# Exposed to the client so the UI knows whether to use Web Speech or upload audio.
NEXT_PUBLIC_VOICE_PROVIDER=browser
# After a finished transcript: "false" = drop into the input to edit then send;
# "true" = send immediately. Client-visible UI behaviour.
NEXT_PUBLIC_VOICE_AUTOSEND=false
# Server-side STT provider used by /api/transcribe when VOICE_PROVIDER=api.
# One of: openai | deepgram
STT_PROVIDER=openai
# Server-side only. Key for the active STT provider.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Future Wispr Flow API key (stub adapter — not wired up yet).
WISPR_API_KEY=
